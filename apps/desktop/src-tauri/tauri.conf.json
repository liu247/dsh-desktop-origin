{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0-rc.8",
  "identifier": "ai.deepseek.harness.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/build-runtime.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop shell",
    "longDescription": "Desktop shell for the DeepSeek Harness agent platform: hosts the local dsh web service and renders the same GUI, plugins, and sessions as the browser edition.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.staging/runtime/runtime/bin/node": "runtime/bin/node",
      "../.staging/runtime/dsh": "dsh"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
